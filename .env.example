# =========================================================
# Mẫu biến môi trường. Copy thành file .env (KHÔNG commit file .env)
# rồi điền giá trị. Trên Vercel: Project Settings -> Environment Variables.
# =========================================================

# --- Supabase (Project Settings -> API) ---
# Bỏ trống khi chạy thử trên máy: dữ liệu lưu vào .data/homecare-db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phiên đăng nhập (không bắt buộc) ---
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập. Bỏ trống thì tự suy ra từ khóa Supabase.
SESSION_SECRET=

# --- OTP ---
# true = chế độ demo, mã OTP hiện trên màn hình thay vì gửi SMS
OTP_DEMO=true

# --- VNPay sandbox (đăng ký miễn phí: https://sandbox.vnpayment.vn/devreg/) ---
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
